# Copia este fichero como .env y rellena los valores. Nunca subas .env al repositorio.
# Todos los límites de riesgo están topados en el código (src/copybot/config.py):
# desde aquí solo se pueden endurecer, nunca relajar.

# Único modo disponible
COPYBOT_MODE=simulation

# Base de datos PostgreSQL
COPYBOT_DATABASE_URL=postgresql+asyncpg://copybot:CAMBIA_ESTA_CONTRASEÑA@db:5432/copybot

# Proveedor RPC de Solana. Si se define COPYBOT_HELIUS_API_KEY, se usa Helius y
# las dos URL siguientes se ignoran.
# COPYBOT_HELIUS_API_KEY=
COPYBOT_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
COPYBOT_SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
COPYBOT_RPC_MAX_REQUESTS_PER_SECOND=1

# Presupuesto mensual máximo en proveedores (tope: 50)
COPYBOT_MONTHLY_BUDGET_USD=50

# Límites de riesgo (valores acordados; solo pueden bajarse)
COPYBOT_RISK_VIRTUAL_CAPITAL_USD=100
COPYBOT_RISK_MAX_POSITION_USD=10
COPYBOT_RISK_MAX_OPEN_POSITIONS=5
COPYBOT_RISK_MIN_CASH_RESERVE_PCT=20
COPYBOT_RISK_MAX_DAILY_LOSS_PCT=10
COPYBOT_RISK_MAX_DRAWDOWN_PCT=25

# Créditos mensuales del plan de Helius (Free: 1.000.000) y porcentaje que puede gastar
# el análisis de traders (descubrimiento e historiales). Al llegar al límite, el análisis
# se detiene antes de pedir nada más; el seguimiento en vivo no se ve afectado.
COPYBOT_HELIUS_MONTHLY_CREDITS=1000000
COPYBOT_ANALYSIS_CREDIT_SHARE_PCT=60

# Días de historial que se importan por wallet y máximo de páginas de 1.000 transacciones
COPYBOT_HISTORY_DAYS=37
COPYBOT_HISTORY_MAX_PAGES=10

# Parámetros del analizador y de la puntuación (ver src/copybot/analysis/). Ejemplos:
# COPYBOT_SCORING_MIN_ROUND_TRIPS=20
# COPYBOT_SCORING_COPY_COST=0.03
